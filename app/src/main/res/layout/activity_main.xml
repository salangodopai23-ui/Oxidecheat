<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0A0A0A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OXIDE CHEAT"
        android:textColor="#DD0000"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0 — by ANON"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: INATIVO"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btn_ativar"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:text="ATIVAR CHEAT"
        android:textColor="#FFFFFF"
        android:backgroundTint="#22AA44"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btn_desativar"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:text="DESATIVAR"
        android:textColor="#FFFFFF"
        android:backgroundTint="#AA2222"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1. Ativa o cheat\n2. Abre o Oxide Mobile\n3. Toca no botão flutuante"
        android:textColor="#666666"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="40dp"/>

</LinearLayout>
